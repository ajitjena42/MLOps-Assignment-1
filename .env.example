# HeartGuard Environment Configuration Example
# Copy this file to .env for local runtime overrides

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Model Configuration
MODEL_PATH=models/heartguard_pipeline.joblib
MODEL_VERSION=1.0.0

# Monitoring & Tracking
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
PROMETHEUS_METRICS_ENABLED=true
